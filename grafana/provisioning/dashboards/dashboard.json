{
  "title": "Semantic Caching Layer",
  "uid": "semantic-cache-layer",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cache hit rate",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "100 * sum(increase(semantic_cache_hits_total[$__range])) / clamp_min(sum(increase(semantic_cache_requests_total[$__range])), 1)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total requests",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum(increase(semantic_cache_requests_total[$__range]))",
          "legendFormat": "requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Estimated cost saved (cumulative)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(semantic_cache_estimated_cost_saved_usd_total)",
          "legendFormat": "saved",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache hit speedup (avg)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "(sum(rate(semantic_cache_request_latency_seconds_sum{cache_status=\"miss\"}[$__range])) / clamp_min(sum(rate(semantic_cache_request_latency_seconds_count{cache_status=\"miss\"}[$__range])), 1)) / clamp_min((sum(rate(semantic_cache_request_latency_seconds_sum{cache_status=\"hit\"}[$__range])) / clamp_min(sum(rate(semantic_cache_request_latency_seconds_count{cache_status=\"hit\"}[$__range])), 1)), 0.001)",
          "legendFormat": "speedup",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Hits vs misses over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(semantic_cache_hits_total[$__rate_interval]))",
          "legendFormat": "hits",
          "refId": "A"
        },
        {
          "expr": "sum(rate(semantic_cache_misses_total[$__rate_interval]))",
          "legendFormat": "misses",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Requests by provider",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "list", "placement": "right" },
        "pieType": "donut"
      },
      "targets": [
        {
          "expr": "sum by (provider) (increase(semantic_cache_requests_total[$__range]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Upstream errors by provider",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 40 },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (provider) (rate(semantic_cache_upstream_errors_total[$__rate_interval]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency: cache hit vs miss (p50 / p95)",
      "description": "This is the headline 'cache hits are Nx faster' comparison. Requires the request_latency_seconds histogram from src/metrics.py.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "miss.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byRegexp", "options": "hit.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(semantic_cache_request_latency_seconds_bucket{cache_status=\"hit\"}[$__rate_interval])) by (le))",
          "legendFormat": "hit p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(semantic_cache_request_latency_seconds_bucket{cache_status=\"hit\"}[$__rate_interval])) by (le))",
          "legendFormat": "hit p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.5, sum(rate(semantic_cache_request_latency_seconds_bucket{cache_status=\"miss\"}[$__rate_interval])) by (le))",
          "legendFormat": "miss p50",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(semantic_cache_request_latency_seconds_bucket{cache_status=\"miss\"}[$__rate_interval])) by (le))",
          "legendFormat": "miss p95",
          "refId": "D"
        }
      ]
    },
    {
      "id": 9,
      "type": "heatmap",
      "title": "Similarity score distribution",
      "description": "Shows how close near-miss queries land relative to the current SIMILARITY_THRESHOLD -- useful for deciding whether to adjust it.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "calculate": false,
        "color": { "mode": "scheme", "scheme": "Oranges" },
        "yAxis": { "unit": "none" }
      },
      "targets": [
        {
          "expr": "sum(increase(semantic_cache_similarity_score_bucket[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    }
  ]
}
